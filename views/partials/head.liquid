<!doctype html>
<html lang="nl">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/styleguide.css">
    <link rel="stylesheet" href="/css/style.css">
    <meta name="Alles over ADConnect op 1 plek. Awards, informatie en nog veel meer">
    <title>{{ title }}</title>
    <script src="/js/menu.js" defer></script>
  </head>
  <body>
    <header class="layout nav-bar">
      <ul class="container top-bar">
        <li>{% include './partials/link.liquid', link: '#', text: "FAQ's", style: 'nav-link' %}</li>
        <li>{% include './partials/link.liquid', link: '#', text: 'Over ons', style: 'nav-link' %}</li>
        <li>{% include './partials/link.liquid', link: '#', text: 'Contact', style: 'nav-link' %}</li>
      </ul>
      <nav class="layout bottom-bar">
        <div class=" container nav-inner">

       
        <ul class="nav-list">
          <li>
            <img src="/img/logo-big.svg" alt="Overlegplatform ad" width="201" height="57" fetchpriority="high">
          </li>
          <li>{% include './partials/link.liquid', link: '#', text: 'Home', style: 'nav-link' %}</li>
          <li>{% include './partials/link.liquid', link: '#', text: "Over Ad's", style: 'nav-link' %}</li>
          <li>{% include './partials/link.liquid', link: '#', text: 'Publicaties', style: 'nav-link' %}</li>
          <li
            class="
              {% if  path  == '/talent-awards' %}
                active
              {% endif %}
            "
          >
            {% include './partials/link.liquid', link: '/talent-awards', text: 'Talent Award', style: 'nav-link' %}
          </li>
          <li>{% include './partials/link.liquid', link: '/nieuws', text: 'Nieuws', style: 'nav-link' %}</li>
          <li>{% include './partials/link.liquid', link: '#', text: 'kom naar Ad-dag ', style: 'primary-button' %}</li>
        </ul>

        <details id="hamburger-menu">
          <summary>
            <svg class="open" viewBox="0 0 100 80" width="40" height="40">
              <rect width="100" height="20"></rect>
              <rect y="30" width="100" height="20"></rect>
              <rect y="60" width="100" height="20"></rect>
            </svg>

            <svg class="close" xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M5.29289 5.29289C5.68342 4.90237 6.31658 4.90237 6.70711 5.29289L12 10.5858L17.2929 5.29289C17.6834 4.90237 18.3166 4.90237 18.7071 5.29289C19.0976 5.68342 19.0976 6.31658 18.7071 6.70711L13.4142 12L18.7071 17.2929C19.0976 17.6834 19.0976 18.3166 18.7071 18.7071C18.3166 19.0976 17.6834 19.0976 17.2929 18.7071L12 13.4142L6.70711 18.7071C6.31658 19.0976 5.68342 19.0976 5.29289 18.7071C4.90237 18.3166 4.90237 17.6834 5.29289 17.2929L10.5858 12L5.29289 6.70711C4.90237 6.31658 4.90237 5.68342 5.29289 5.29289Z" fill="#0F1729"/>
            </svg>
          </summary>
          <ul id="hamburger-list">
            <li>{% include './partials/link.liquid', link: '#', text: 'Home', style: 'nav-link' %}</li>
            <li>{% include './partials/link.liquid', link: '#', text: "Over Ad's", style: 'nav-link' %}</li>
            <li>{% include './partials/link.liquid', link: '#', text: 'Publicaties', style: 'nav-link' %}</li>
            <li>
              {% include './partials/link.liquid', link: '/talent-awards', text: 'Talent Award', style: 'nav-link' %}
            </li>
            <li>{% include './partials/link.liquid', link: '/nieuws', text: 'Nieuws', style: 'nav-link' %}</li>
                      <li>{% include './partials/link.liquid', link: '#', text: 'kom naar Ad-dag ', style: 'primary-button' %}</li>

          </ul>
        </details>
         </div>
      </nav>
    </header>
    <main>

  {% comment %} </body>
</html> {% endcomment %}
