{% render 'partials/head.liquid', title: 'awards', path: path %}

{% comment %} {% include 'partials/article.liquid', style: 'banner' %} {% endcomment %}

<section class="layout nominee-list ">
  <article class="container">
    <h2>Genomideerde</h2>
    <ul>
      {% for nominee in nominations %}
        {% if nominee.profile_picture == null %}
          {% assign imgURL = 'https://static.wikia.nocookie.net/overwatch_gamepedia/images/6/6f/Icon-Ramattra.png/revision/latest/scale-to-width-down/250?cb=20221206190323' %}
        {% else %}
          {% assign imgURL = 'https://fdnd-agency.directus.app/assets/' | append: nominee.profile_picture %}
        {% endif %}

        <li>
          <h3>{{ nominee.title }}</h3>
          {% include 'partials/picture.liquid', imgURL: imgURL, width: 250, imgAlt: nominee.title %}
          <p>{{ nominee.institution | default: 'Hogeschool van games throwen' }}</p>
          <a href="{{'/talent-awards/2026/' | append: nominee.id}}" class="primary-button"> bekijk nominatie </a>
        </li>
      {% endfor %}
    </ul>
  </article>
</section>

{% render 'partials/foot.liquid' %}
